<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.fithubapp.controller.WorkoutScreenController"
            prefWidth="390" prefHeight="844"
            minWidth="390" maxWidth="390"
            minHeight="844" maxHeight="844"
            stylesheets="@../css/fithub-mobile.css"
            styleClass="phone-root">

    <top>
        <VBox styleClass="phone-header">
            <HBox alignment="CENTER_LEFT" styleClass="status-bar">
                <Label text="9:41" styleClass="status-time"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="▮▮▮  ◔  ▰" styleClass="status-icons"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="9" styleClass="brand-line">
                <Label text="Workouts" styleClass="eyebrow"/>
                <Label text="▮▮▮" styleClass="brand-mark"/>
                <Label text="Fit" styleClass="brand-fit"/>
                <Label text="Hub" styleClass="brand-hub"/>
            </HBox>

            <Label text="Workouts" styleClass="page-title"/>
            <Label text="Choose a workout for today" styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="screen-content">

            <VBox spacing="10" styleClass="panel">
                <Label text="Upper Body" styleClass="panel-title"/>
                <Label text="Chest, shoulders, and arms" styleClass="profile-detail"/>
                <Label text="Estimated time: 35 minutes" styleClass="profile-detail"/>
                <Button text="Start Workout" styleClass="primary-button"/>
            </VBox>

            <VBox spacing="10" styleClass="panel">
                <Label text="Lower Body" styleClass="panel-title"/>
                <Label text="Legs and glutes" styleClass="profile-detail"/>
                <Label text="Estimated time: 40 minutes" styleClass="profile-detail"/>
                <Button text="Start Workout" styleClass="primary-button"/>
            </VBox>

            <VBox spacing="10" styleClass="panel">
                <Label text="Full Body" styleClass="panel-title"/>
                <Label text="Complete body workout" styleClass="profile-detail"/>
                <Label text="Estimated time: 50 minutes" styleClass="profile-detail"/>
                <Button text="Start Workout" styleClass="primary-button"/>
            </VBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="42" styleClass="bottom-nav">

            <VBox alignment="CENTER"
                  spacing="3"
                  onMouseClicked="#openProfile"
                  styleClass="nav-clickable">
                <Label text="◯" styleClass="nav-icon"/>
                <Label text="Profile" styleClass="nav-text"/>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="3"
                  onMouseClicked="#openDashboard"
                  styleClass="nav-clickable">
                <Label text="✚" styleClass="nav-icon-active"/>
                <Label text="Workouts" styleClass="nav-text-active"/>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="3"
                  onMouseClicked="#openSettings"
                  styleClass="nav-clickable">
                <Label text="⊙" styleClass="nav-icon"/>
                <Label text="Settings" styleClass="nav-text"/>
            </VBox>

        </HBox>
    </bottom>

</BorderPane>
