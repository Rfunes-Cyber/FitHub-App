<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.fithubapp.controller.SettingsController"
            prefWidth="390" prefHeight="844"
            minWidth="390" maxWidth="390"
            minHeight="844" maxHeight="844"
            stylesheets="@../css/fithub-mobile.css"
            styleClass="phone-root">

    <top>
        <VBox styleClass="phone-header">
            <HBox alignment="CENTER_LEFT" styleClass="status-bar">
                <Label text="9:41" styleClass="status-time"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="▮▮▮  ◔  ▰" styleClass="status-icons"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="9" styleClass="brand-line">
                <Label text="Settings" styleClass="eyebrow"/>
                <Label text="▮▮▮" styleClass="brand-mark"/>
                <Label text="Fit" styleClass="brand-fit"/>
                <Label text="Hub" styleClass="brand-hub"/>
            </HBox>

            <Label text="Settings" styleClass="page-title"/>
            <Label text="Manage your app preferences" styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="22" styleClass="screen-content">
            <VBox spacing="12" styleClass="panel">
                <Label text="Account" styleClass="panel-title"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Abdulrahman Aladadi" styleClass="profile-detail"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="›" styleClass="link-label"/>
                </HBox>
            </VBox>

            <VBox spacing="18" styleClass="panel">
                <Label text="Preferences" styleClass="panel-title"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Dark Mode" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton selected="true" styleClass="switch-button"/>
                </HBox>

                <Region prefHeight="1" styleClass="divider"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Units" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="lbs / ft" styleClass="settings-value"/>
                </HBox>

                <Region prefHeight="1" styleClass="divider"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Goal Reminders" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton selected="true" styleClass="switch-button"/>
                </HBox>
            </VBox>

            <VBox spacing="12" styleClass="panel">
                <Label text="Support" styleClass="panel-title"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Help Center" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="›" styleClass="link-label"/>
                </HBox>
                <Label text="Log Out" styleClass="logout-label"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="42" styleClass="bottom-nav">
            <VBox alignment="CENTER" spacing="3"
                  onMouseClicked="#openProfile"
                  styleClass="nav-clickable">
                <Label text="◯" styleClass="nav-icon"/>
                <Label text="Profile" styleClass="nav-text"/>
            </VBox>

            <VBox alignment="CENTER" spacing="3"
                  onMouseClicked="#openWorkouts"
                  styleClass="nav-clickable">
                <Label text="✚" styleClass="nav-icon"/>
                <Label text="Workouts" styleClass="nav-text"/>
            </VBox>

            <VBox alignment="CENTER" spacing="3">
                <Label text="⊙" styleClass="nav-icon-active"/>
                <Label text="Settings" styleClass="nav-text-active"/>
            </VBox>
        </HBox>
    </bottom>
</BorderPane>
