<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<AnchorPane prefHeight="960.0" prefWidth="540.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.fithubapp.controller.NutritionController">
    <fx:define>
        <ToggleGroup fx:id="activityGroup"/>
        <ToggleGroup fx:id="goalGroup"/>
    </fx:define>

    <ImageView fitHeight="960" fitWidth="1200" layoutX="-350" layoutY="0" preserveRatio="false"><image><Image url="@../images/nutrition-background.jpeg"/></image></ImageView>
    <AnchorPane prefHeight="960" prefWidth="540" styleClass="nutrition-overlay"/>
    <HBox layoutX="48" layoutY="40" alignment="CENTER_LEFT" spacing="0">
        <Text text="Fit" styleClass="nutrition-brand-large"/>
        <Text text="Hub" styleClass="nutrition-brand-white"/>
    </HBox>

    <Label layoutX="58" layoutY="128" text="Activity Level:" styleClass="nutrition-section-title"/>
    <VBox layoutX="66" layoutY="180" spacing="18">
        <RadioButton fx:id="littleActivityRadio" text="Little to none exercise" toggleGroup="$activityGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="lightActivityRadio" text="Lightly active (1-3 times/week)" toggleGroup="$activityGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="moderateActivityRadio" text="Moderately (3-4 times/week)" toggleGroup="$activityGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="veryActivityRadio" text="Very active (6-7 times/week)" toggleGroup="$activityGroup" styleClass="nutrition-radio"/>
    </VBox>

    <Label layoutX="58" layoutY="405" text="Fitness Goal:" styleClass="nutrition-section-title"/>
    <VBox layoutX="66" layoutY="457" spacing="18">
        <RadioButton fx:id="maintainRadio" text="Maintain" toggleGroup="$goalGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="lossRadio" text="Weight loss (1lb)" toggleGroup="$goalGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="extremeLossRadio" text="Extreme weight loss (2lbs)" toggleGroup="$goalGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="gainRadio" text="Weight gain (1lb)" toggleGroup="$goalGroup" styleClass="nutrition-radio"/>
        <RadioButton fx:id="extremeGainRadio" text="Extreme weight gain (2lbs)" toggleGroup="$goalGroup" styleClass="nutrition-radio"/>
    </VBox>

    <HBox fx:id="errorBox" layoutX="70" layoutY="686" prefWidth="400" alignment="CENTER" spacing="8" visible="false" managed="false">
        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
            <image><Image url="@../images/nutrition-icons/error.png"/></image>
        </ImageView>

        <Label fx:id="messageLabel" prefWidth="360" alignment="CENTER_LEFT" wrapText="true" styleClass="message-label"/>
    </HBox>

    <Button layoutX="110" layoutY="748" prefHeight="50" prefWidth="320" text="Calculate" onAction="#calculateNutrition" styleClass="nutrition-primary-button"/>
    <Button layoutX="180" layoutY="815" prefWidth="180" text="Back" onAction="#backToPersonalInfo" styleClass="link-button"/>
</AnchorPane>
