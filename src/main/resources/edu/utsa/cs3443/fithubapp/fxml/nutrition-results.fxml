<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<AnchorPane prefHeight="960.0" prefWidth="540.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.fithubapp.controller.NutritionController">
    <ImageView fitHeight="960" fitWidth="540" preserveRatio="false"><image><Image url="@../images/nutrition-background.jpeg"/></image></ImageView>
    <AnchorPane prefHeight="960" prefWidth="540" styleClass="nutrition-overlay"/>

    <Text layoutX="42" layoutY="82" text="Your Results are Ready!" styleClass="nutrition-brand-large"/>
    <Label layoutX="46" layoutY="106" prefWidth="448" wrapText="true" text="Based on your information, here are your tailored calorie and macronutrients" styleClass="nutrition-subtitle-strong"/>

    <VBox layoutX="48" layoutY="210" prefWidth="444" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="result-card">
            <ImageView fitHeight="38" fitWidth="38" preserveRatio="true"><image><Image url="@../images/nutrition-icons/calories.png"/></image></ImageView>
            <VBox spacing="1"><Label text="Calories" styleClass="result-name"/><Label fx:id="caloriesLabel" text="0 kcal" styleClass="result-value"/></VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="result-card">
            <ImageView fitHeight="38" fitWidth="38" preserveRatio="true"><image><Image url="@../images/nutrition-icons/protein.png"/></image></ImageView>
            <VBox spacing="1"><Label text="Protein" styleClass="result-name"/><Label fx:id="proteinLabel" text="0 g" styleClass="result-value"/></VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="result-card">
            <ImageView fitHeight="38" fitWidth="38" preserveRatio="true"><image><Image url="@../images/nutrition-icons/carbs.png"/></image></ImageView>
            <VBox spacing="1"><Label text="Carbs" styleClass="result-name"/><Label fx:id="carbsLabel" text="0 g" styleClass="result-value"/></VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="result-card">
            <ImageView fitHeight="38" fitWidth="38" preserveRatio="true"><image><Image url="@../images/nutrition-icons/fat.png"/></image></ImageView>
            <VBox spacing="1"><Label text="Fat" styleClass="result-name"/><Label fx:id="fatLabel" text="0 g" styleClass="result-value"/></VBox>
        </HBox>
    </VBox>

    <HBox layoutX="58" layoutY="687" prefWidth="424" alignment="CENTER_LEFT" spacing="12" styleClass="pro-tip-box">
        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true"><image><Image url="@../images/nutrition-icons/star.png"/></image></ImageView>
        <VBox spacing="1"><Label text="Pro Tip" styleClass="pro-tip-title"/><Label prefWidth="345" wrapText="true" text="Stay consistent and these numbers will help you reach your goals!" styleClass="nutrition-note-text"/></VBox>
    </HBox>

    <Button layoutX="95" layoutY="810" prefHeight="50" prefWidth="350" text="Proceed to Dashboard" onAction="#proceedToDashboard" styleClass="nutrition-primary-button"/>
</AnchorPane>
