@startuml

title FitHub Application UML Class Diagram

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

' =========================================================
' APPLICATION
' =========================================================

package "Application" {

    class FitHubApplication {
        -{static} primaryStage : Stage

        +start(stage : Stage) : void
        +{static} showScreen(file : String) : void
        +{static} main(args : String[]) : void
    }

    class JavaFXApplication <<external>>
}

FitHubApplication --|> JavaFXApplication


' =========================================================
' CONTROLLERS
' =========================================================

package "Controllers" {

    class CreateAccountController {
        -handleCreateAccount() : void
        -returnToLogin() : void
        -error(message : String) : void
        -success(message : String) : void
    }

    class LoginController {
        -handleLogin() : void
        -openCreateAccount() : void
        -openPasswordReset() : void
        -error(message : String) : void
        -success(message : String) : void
    }

    class PasswordResetController {
        -handleResetPassword() : void
        -returnToLogin() : void
        -error(message : String) : void
        -success(message : String) : void
    }

    class NutritionController {
        -initialize() : void
        -continueToGoals() : void
        -calculateNutrition() : void
        -backToPersonalInfo() : void
        -proceedToDashboard() : void
        -error(message : String) : void
    }

    class DashboardController {
        -dashboardSummary : DashboardSummary
        -macroNutrients : List<MacroNutrient>
        -calorieHistory : List<CalorieHistoryEntry>

        +DashboardController()
        -initialize() : void
        +loadSampleDashboardData() : void
        -updateDashboardView() : void
        -updateCalorieHistoryChart() : void
        +calculateCaloriesRemaining() : int
        -openProfile(event : MouseEvent) : void
        -openWorkouts(event : MouseEvent) : void
        -openSettings(event : MouseEvent) : void
    }

    class ProfileController {
        -openDashboard(event : MouseEvent) : void
        -openWorkouts(event : MouseEvent) : void
        -openSettings(event : MouseEvent) : void
    }

    class SettingsController {
        -openDashboard(event : MouseEvent) : void
        -openWorkouts(event : MouseEvent) : void
        -openProfile(event : MouseEvent) : void
    }

    class WorkoutScreenController {
        -openDashboard(event : MouseEvent) : void
        -openProfile(event : MouseEvent) : void
        -openSettings(event : MouseEvent) : void
    }

    class ScreenNavigator <<utility>> {
        -ScreenNavigator()
        +{static} open(event : MouseEvent, fxmlFile : String) : void
    }

    class WorkoutController {
        -{static} NO_PREFERENCE : String
        -generatedWorkout : Workout
        -activeSession : WorkoutSession
        -workoutTimer : Timeline
        -elapsedSeconds : int
        -workoutPaused : boolean

        -initialize() : void
        -updateExercisePreferences() : void
        -setupWorkoutTimer() : void
        -handleGenerateWorkout() : void
        -handleStartWorkout() : void
        -handleCompleteSet() : void
        -handleSkipExercise() : void
        -handlePauseWorkout() : void
        -updateSessionDisplay() : void
        -showCompletedWorkout() : void
        -showError(message : String) : void
    }
}


' =========================================================
' MODELS
' =========================================================

package "Models" {

    class AccountStore <<utility>> {
        -{static} STORE : Path

        -AccountStore()
        +{static} accountExists() : boolean
        +{static} createAccount(username : String, password : String) : void
        +{static} authenticate(username : String, password : String) : boolean
        +{static} changePassword(username : String, password : String) : boolean
        -{static} load() : Properties
        -{static} save(properties : Properties) : void
        -{static} hash(value : String) : String
    }

    class AppSession <<utility>> {
        -{static} username : String
        -{static} userInfo : UserInfo
        -{static} nutritionResults : NutritionResults

        -AppSession()
        +{static} getUsername() : String
        +{static} setUsername(username : String) : void
        +{static} getUserInfo() : UserInfo
        +{static} setUserInfo(userInfo : UserInfo) : void
        +{static} getNutritionResults() : NutritionResults
        +{static} setNutritionResults(results : NutritionResults) : void
        +{static} clearNutrition() : void
    }

    class UserInfo {
        -age : int
        -heightCm : double
        -weightKg : double
        -gender : String
        -activityLevel : String
        -fitnessGoal : String

        +UserInfo()
        +UserInfo(age : int, heightCm : double, weightKg : double,
                  gender : String, activityLevel : String,
                  fitnessGoal : String)
        +getAge() : int
        +setAge(age : int) : void
        +getHeightCm() : double
        +setHeightCm(heightCm : double) : void
        +getWeightKg() : double
        +setWeightKg(weightKg : double) : void
        +getGender() : String
        +setGender(gender : String) : void
        +getActivityLevel() : String
        +setActivityLevel(activityLevel : String) : void
        +getFitnessGoal() : String
        +setFitnessGoal(fitnessGoal : String) : void
    }

    class NutritionResults {
        -bmr : double
        -tdee : double
        -dailyCalories : double
        -proteinGrams : double
        -carbohydrateGrams : double
        -fatGrams : double

        +NutritionResults(bmr : double, tdee : double,
                          dailyCalories : double,
                          proteinGrams : double,
                          carbohydrateGrams : double,
                          fatGrams : double)
        +getBmr() : double
        +getTdee() : double
        +getDailyCalories() : double
        +getProteinGrams() : double
        +getCarbohydrateGrams() : double
        +getFatGrams() : double
    }

    class DashboardSummary {
        -userId : String
        -userName : String
        -calorieGoal : int
        -caloriesConsumed : int
        -dayStreak : int

        +DashboardSummary(userId : String, userName : String,
                          calorieGoal : int, caloriesConsumed : int,
                          dayStreak : int)
        +getCaloriesRemaining() : int
        +getDailyGoalPercent() : double
        +getUserName() : String
        +getCalorieGoal() : int
        +getCaloriesConsumed() : int
        +getDayStreak() : int
    }

    class MacroNutrient {
        -name : String
        -consumedGrams : int
        -targetGrams : int

        +MacroNutrient(name : String, consumedGrams : int,
                       targetGrams : int)
        +getProgressPercent() : double
        +getName() : String
        +getConsumedGrams() : int
        +getTargetGrams() : int
    }

    class CalorieHistoryEntry {
        -dayLabel : String
        -caloriesConsumed : int

        +CalorieHistoryEntry(dayLabel : String,
                             caloriesConsumed : int)
        +getDayLabel() : String
        +getCaloriesConsumed() : int
    }

    class Exercise {
        -workoutName : String
        -name : String
        -muscleGroup : String
        -equipmentType : String
        -sets : int
        -reps : int

        +Exercise(workoutName : String, name : String,
                  muscleGroup : String, equipmentType : String,
                  sets : int, reps : int)
        +getWorkoutName() : String
        +getName() : String
        +getMuscleGroup() : String
        +getEquipmentType() : String
        +getSets() : int
        +getReps() : int
        +toString() : String
    }

    class Workout {
        -name : String
        -durationMin : int
        -muscleGroups : ArrayList<String>
        -exercises : ArrayList<Exercise>

        +Workout(name : String, durationMin : int)
        +addExercise(exercise : Exercise) : void
        +addMuscleGroup(muscleGroup : String) : void
        +getName() : String
        +getDurationMin() : int
        +getMuscleGroups() : ArrayList<String>
        +getExercises() : ArrayList<Exercise>
        +toString() : String
    }

    class WorkoutSession {
        -workout : Workout
        -currentExerciseIndex : int
        -currentSet : int
        -completedSets : int
        -workoutFinished : boolean

        +WorkoutSession(workout : Workout)
        +getWorkout() : Workout
        +getCurrentExercise() : Exercise
        +getCurrentSet() : int
        +getCompletedSets() : int
        +isWorkoutFinished() : boolean
        +completeSet() : void
        +skipExercise() : void
        -moveToNextExercise() : void
        +getTotalSets() : int
        +getProgressPercent() : double
        +toString() : String
    }
}


' =========================================================
' UTILITIES
' =========================================================

package "Utilities" {

    class NutritionCalc <<utility>> {
        -NutritionCalc()

        +{static} calculate(age : int, heightCm : double,
                            weightKg : double, gender : String,
                            activityLevel : String,
                            fitnessGoal : String) : NutritionResults
        -{static} calculateBmr(age : int, heightCm : double,
                              weightKg : double,
                              gender : String) : double
        -{static} getActivityMultiplier(activityLevel : String) : double
        -{static} adjustCaloriesForGoal(tdee : double,
                                        fitnessGoal : String) : double
        -{static} validateInputs(age : int, heightCm : double,
                                 weightKg : double, gender : String,
                                 activityLevel : String,
                                 fitnessGoal : String) : void
    }

    class ExerciseFileLoader <<utility>> {
        -{static} RESOURCE_PATH : String

        -ExerciseFileLoader()
        +{static} loadExercises(
            selectedMuscleGroups : ArrayList<String>,
            selectedEquipmentType : String
        ) : ArrayList<Exercise>
        +{static} loadExerciseNames(
            selectedMuscleGroups : ArrayList<String>,
            selectedEquipmentType : String
        ) : ArrayList<String>
        +{static} findExerciseByName(
            exercises : ArrayList<Exercise>,
            exerciseName : String
        ) : Exercise
        -{static} openCsvReader() : BufferedReader
    }

    class WorkoutGenerator <<utility>> {
        -{static} NO_PREFERENCE : String

        -WorkoutGenerator()
        +{static} generateWorkout(
            selectedMuscleGroups : ArrayList<String>,
            equipmentType : String
        ) : Workout
        +{static} generateWorkout(
            selectedMuscleGroups : ArrayList<String>,
            equipmentType : String,
            preferredExerciseName : String
        ) : Workout
        -{static} getPreferredExercise(
            matchingExercises : ArrayList<Exercise>,
            preferredExerciseName : String
        ) : Exercise
    }
}


' =========================================================
' MODEL RELATIONSHIPS
' =========================================================

Workout "1" *-- "1..*" Exercise : contains

WorkoutSession --> "1" Workout : manages
WorkoutSession --> "0..1" Exercise : tracks current

AppSession --> "0..1" UserInfo : stores
AppSession --> "0..1" NutritionResults : stores

DashboardController --> "0..1" DashboardSummary : manages
DashboardController --> "0..*" MacroNutrient : manages
DashboardController --> "0..*" CalorieHistoryEntry : manages


' =========================================================
' CONTROLLER DEPENDENCIES
' =========================================================

CreateAccountController ..> AccountStore : creates account
CreateAccountController ..> FitHubApplication : returns to login

LoginController ..> AccountStore : authenticates
LoginController ..> AppSession : starts session
LoginController ..> FitHubApplication : opens screens

PasswordResetController ..> AccountStore : changes password
PasswordResetController ..> FitHubApplication : returns to login

NutritionController ..> AppSession : reads and stores data
NutritionController ..> UserInfo : creates
NutritionController ..> NutritionCalc : calculates
NutritionController ..> NutritionResults : displays
NutritionController ..> FitHubApplication : opens screens

WorkoutController ..> ExerciseFileLoader : loads preferences
WorkoutController ..> WorkoutGenerator : generates
WorkoutController --> "0..1" Workout : stores
WorkoutController --> "0..1" WorkoutSession : controls
WorkoutController ..> Exercise : displays


' =========================================================
' NAVIGATION DEPENDENCIES
' =========================================================

DashboardController ..> ScreenNavigator : navigates
ProfileController ..> ScreenNavigator : navigates
SettingsController ..> ScreenNavigator : navigates
WorkoutScreenController ..> ScreenNavigator : navigates


' =========================================================
' UTILITY DEPENDENCIES
' =========================================================

NutritionCalc ..> NutritionResults : creates

WorkoutGenerator ..> Workout : creates
WorkoutGenerator ..> ExerciseFileLoader : uses
ExerciseFileLoader ..> Exercise : creates


' =========================================================
' NOTES
' =========================================================

note right of WorkoutScreenController
Navigation-only controller for the
mobile dashboard navigation bar.
end note

note right of WorkoutController
Controls workout generation,
exercise preferences, timer,
sets, progress, and completion.
end note

@enduml